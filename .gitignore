# Data files are large and come from Kaggle; never commit them
data/raw/*
!data/raw/.gitkeep

# Generated by the pipeline (reports are committed so results show on GitHub)
artifacts/*
!artifacts/.gitkeep
mlruns/
dbt/target/
dbt/logs/
dbt/.user.yml

# Python / OS
__pycache__/
*.pyc
.venv/
.env
.pytest_cache/
.DS_Store
